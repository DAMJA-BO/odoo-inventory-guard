#. module: inventory_guard
#: model:ir.model.fields,help:inventory_guard.field_inventory_guard_policy__location_ids
msgid "Leave empty to protect all internal locations. Selected locations include their children."
msgstr "Deje vacío para proteger todas las ubicaciones internas. Las ubicaciones seleccionadas incluyen sus ubicaciones hijas."

#. module: inventory_guard
#: code:addons/inventory_guard/models/policy.py:0
msgid "Protected locations must be internal and belong to the policy company."
msgstr "Las ubicaciones protegidas deben ser internas y pertenecer a la empresa de la política."

#. module: inventory_guard
#: code:addons/inventory_guard/models/stock_move_line.py:0
msgid "Inventory Guard blocked %(operation)s: %(product)s at %(location)s. Requested: %(requested)s; remaining physical stock: %(remaining)s. Check the lot, package and owner or reduce the quantity."
msgstr "Inventory Guard bloqueó %(operation)s: %(product)s en %(location)s. Cantidad solicitada: %(requested)s; existencias físicas restantes: %(remaining)s. Revise el lote, paquete y propietario o reduzca la cantidad."

#. module: inventory_guard
#: model_terms:ir.ui.view,arch_db:inventory_guard.policy_form
msgid "Protected operations"
msgstr "Operaciones protegidas"

#. module: inventory_guard
#: model_terms:ir.ui.view,arch_db:inventory_guard.policy_form
msgid "Internal source locations only. Transit is excluded. Positive corrections of existing negative stock are allowed. No override is available."
msgstr "Solo ubicaciones de origen internas. Se excluye el tránsito. Se permiten correcciones positivas de existencias negativas existentes. No se permite omitir el bloqueo."

#. module: inventory_guard

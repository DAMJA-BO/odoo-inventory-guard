<odoo>
    <record id="policy_list" model="ir.ui.view">
        <field name="name">inventory.guard.policy.list</field>
        <field name="model">inventory.guard.policy</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="company_id"/>
                <field name="enabled"/>
                <field name="location_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="policy_general_form" model="ir.ui.view">
        <field name="name">inventory.guard.policy.general.form</field>
        <field name="model">inventory.guard.policy</field>
        <field name="arch" type="xml">
            <form string="General" create="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="name"/>
                        <field name="enabled"/>
                        <field name="location_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="policy_operations_form" model="ir.ui.view">
        <field name="name">inventory.guard.policy.operations.form</field>
        <field name="model">inventory.guard.policy</field>
        <field name="arch" type="xml">
            <form string="Operations" create="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="enabled" readonly="1"/>
                        <field name="protect_transfers"/>
                        <field name="protect_deliveries"/>
                        <field name="protect_vendor_returns"/>
                        <field name="protect_scrap"/>
                        <field name="protect_adjustments"/>
                        <field name="protect_manufacturing"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="policy_action" model="ir.actions.act_window">
        <field name="name">Overview</field>
        <field name="res_model">inventory.guard.policy</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="policy_list"/>
        <field name="help" type="html">
            <p>Open General to configure protection for the active company.</p>
        </field>
    </record>
    <record id="policy_general_action" model="ir.actions.server">
        <field name="name">General</field>
        <field name="model_id" ref="model_inventory_guard_policy"/>
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = model._open_company_settings('general')</field>
    </record>
    <record id="policy_operations_action" model="ir.actions.server">
        <field name="name">Operations</field>
        <field name="model_id" ref="model_inventory_guard_policy"/>
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = model._open_company_settings('operations')</field>
    </record>
    <record id="inventory_guard_root" model="ir.ui.menu">
        <field name="name">Inventory Guard</field>
        <field name="sequence">60</field>
        <field name="group_ids" eval="[(5, 0, 0)]"/>
    </record>
    <menuitem id="inventory_guard_policy_menu" name="Overview" parent="inventory_guard_root"
              action="policy_action" sequence="10" groups="stock.group_stock_user"/>
    <menuitem id="inventory_guard_general_menu" name="General" parent="inventory_guard_root"
              action="policy_general_action" sequence="20" groups="stock.group_stock_manager"/>
    <menuitem id="inventory_guard_operations_menu" name="Operations" parent="inventory_guard_root"
              action="policy_operations_action" sequence="30" groups="stock.group_stock_manager"/>
    <menuitem id="inventory_guard_stock_menu" name="Inventory Guard" parent="stock.menu_stock_config_settings"
              action="policy_general_action" groups="stock.group_stock_manager"/>
</odoo>

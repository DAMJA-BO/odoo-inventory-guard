<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inventory_guard" model="ir.ui.view">
        <field name="name">pos.config.form.stock.guard</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']//setting[field[@name='default_partner_id']]" position="after">
                <setting id="block_negative_stock"
                         string="Block sales with insufficient stock"
                         help="Check available stock at the POS source location before checkout.">
                    <field name="block_negative_stock" readonly="has_active_session"/>
                    <div class="text-muted mt8" invisible="not block_negative_stock">
                        Requires inventory updates after each order and an online connection.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_inventory_guard" model="ir.ui.view">
        <field name="name">res.config.settings.form.stock.guard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='product_and_category_block']" position="after">
                <block title="Inventory Guard" id="pos_inventory_guard_section">
                    <setting id="pos_block_negative_stock" string="Block sales with insufficient stock"
                             help="Validate checkout on the server. Requires inventory updates after each order and an online connection.">
                        <field name="pos_block_negative_stock" readonly="pos_has_active_session"/>
                    </setting>
                    <setting string="Stock display mode"
                             help="Applies to product badges and order indicators. Colors-only mode retains accessible labels and tooltips.">
                        <field name="pos_inventory_guard_display_mode" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_show_badges" string="Show stock badges"
                             help="Display availability on product cards.">
                        <field name="pos_inventory_guard_show_badges" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_block_add" string="Block adding out-of-stock products"
                             help="Check the selected variant before creating a line, including barcode scans.">
                        <field name="pos_inventory_guard_block_add" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_limit_quantity" string="Prevent quantities above available stock"
                             help="Check total positive quantities across duplicate order lines.">
                        <field name="pos_inventory_guard_limit_quantity" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_show_order" string="Show stock on order lines"
                             help="Display availability, highlight shortages and show a cart warning.">
                        <field name="pos_inventory_guard_show_order" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_available_filter" string="Enable Available only filter"
                             help="Let the cashier temporarily filter the catalog; products remain visible by default.">
                        <field name="pos_inventory_guard_available_filter" readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pos_inventory_guard_low_stock" string="Highlight low stock"
                             help="Use a warning color at or below the threshold.">
                        <field name="pos_inventory_guard_low_stock" readonly="pos_has_active_session"/>
                        <div class="content-group" invisible="not pos_inventory_guard_low_stock">
                            <label for="pos_inventory_guard_low_threshold"/>
                            <field name="pos_inventory_guard_low_threshold" readonly="pos_has_active_session"/>
                            <div class="text-muted">Threshold in each product's default unit of measure.</div>
                        </div>
                    </setting>
                    <setting id="pos_inventory_guard_auto_refresh" string="Automatically refresh stock"
                             help="Refresh advisory quantities while the product screen is open.">
                        <field name="pos_inventory_guard_auto_refresh" readonly="pos_has_active_session"/>
                        <div class="content-group" invisible="not pos_inventory_guard_auto_refresh">
                            <label for="pos_inventory_guard_refresh_seconds"/>
                            <field name="pos_inventory_guard_refresh_seconds" readonly="pos_has_active_session"/>
                            <div class="text-muted">Default: 30 seconds. Minimum: 5 seconds. Checkout always rechecks the server.</div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Inventory Guard"
msgstr "Inventory Guard"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Stock unknown"
msgstr "Existencias desconocidas"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Out of stock"
msgstr "Sin existencias"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Low stock: %s"
msgstr "Existencias bajas: %s"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Available: %s"
msgstr "Disponible: %s"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Variants — %s"
msgstr "Variantes — %s"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/components_patch.js:0
msgid "Requested: %s · Available: %s"
msgstr "Solicitado: %s · Disponible: %s"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/order_line_patch.js:0
msgid "Availability is unknown. Refresh stock before increasing the quantity."
msgstr "Se desconoce la disponibilidad. Actualice las existencias antes de aumentar la cantidad."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/order_line_patch.js:0
#: code:addons/pos_inventory_guard/static/src/stock/store_patch.js:0
msgid "%s: requested %s; available %s"
msgstr "%s: solicitado %s; disponible %s"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/store_patch.js:0
msgid "Connect to the server before adding this product."
msgstr "Conéctese al servidor antes de añadir este producto."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/store_patch.js:0
msgid "Availability is unknown. Refresh stock and try again."
msgstr "Se desconoce la disponibilidad. Actualice las existencias y vuelva a intentarlo."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.pos_config_view_form_inventory_guard
msgid "Check available stock at the POS source location before checkout."
msgstr "Comprobar las existencias disponibles en la ubicación de origen del PdV antes del cobro."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.pos_config_view_form_inventory_guard
msgid "Requires inventory updates after each order and an online connection."
msgstr "Requiere actualizar el inventario después de cada pedido y una conexión a Internet."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Validate checkout on the server. Requires inventory updates after each order and an online connection."
msgstr "Validar el cobro en el servidor. Requiere actualizar el inventario después de cada pedido y una conexión a Internet."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Applies to product badges and order indicators. Colors-only mode retains accessible labels and tooltips."
msgstr "Se aplica a los indicadores de productos y de pedidos. El modo Solo colores conserva las etiquetas de accesibilidad y la información al pasar el cursor."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Display availability on product cards."
msgstr "Mostrar la disponibilidad en las tarjetas de productos."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Check the selected variant before creating a line, including barcode scans."
msgstr "Comprobar la variante seleccionada antes de crear una línea, incluidas las lecturas de códigos de barras."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Check total positive quantities across duplicate order lines."
msgstr "Comprobar el total de cantidades positivas entre las líneas duplicadas del pedido."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Display availability, highlight shortages and show a cart warning."
msgstr "Mostrar la disponibilidad, resaltar las faltas de existencias y mostrar un aviso en el carrito."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Let the cashier temporarily filter the catalog; products remain visible by default."
msgstr "Permitir al cajero filtrar temporalmente el catálogo; los productos permanecen visibles de forma predeterminada."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Use a warning color at or below the threshold."
msgstr "Usar un color de advertencia cuando las existencias sean iguales o inferiores al umbral."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Threshold in each product's default unit of measure."
msgstr "Umbral en la unidad de medida predeterminada de cada producto."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Refresh advisory quantities while the product screen is open."
msgstr "Actualizar las cantidades informativas mientras esté abierta la pantalla de productos."

#. module: pos_inventory_guard
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Default: 30 seconds. Minimum: 5 seconds. Checkout always rechecks the server."
msgstr "Predeterminado: 30 segundos. Mínimo: 5 segundos. Si la protección final está activada, el cobro vuelve a comprobar las existencias en el servidor."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "Stock may be outdated"
msgstr "Las existencias pueden estar desactualizadas"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0

msgstr "Modo de visualización de existencias"

#. module: pos_inventory_guard
#: model:ir.model.fields.selection,name:pos_inventory_guard.selection__pos_config__inventory_guard_display_mode__quantity
#: model:ir.model.fields.selection,name:pos_inventory_guard.selection__res_config_settings__pos_inventory_guard_display_mode__quantity
msgid "Quantity, text and colors"
msgstr "Cantidad, texto y colores"

#. module: pos_inventory_guard
#: model:ir.model.fields.selection,name:pos_inventory_guard.selection__pos_config__inventory_guard_display_mode__color
#: model:ir.model.fields.selection,name:pos_inventory_guard.selection__res_config_settings__pos_inventory_guard_display_mode__color
msgid "Colors only"
msgstr "Solo colores"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_block_add
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_block_add
msgid "Block adding out-of-stock products"
msgstr "Bloquear la adición de productos sin existencias"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_limit_quantity
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_limit_quantity
msgid "Prevent quantities above available stock"
msgstr "Impedir cantidades superiores a las existencias disponibles"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_show_order
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_show_order

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "Available only"
msgstr "Solo disponibles"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "Stock update unavailable — quantities may be outdated."
msgstr "Actualización de existencias no disponible — las cantidades pueden estar desactualizadas."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "· Updated:"
msgstr "· Actualizado:"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "Stock not loaded yet."
msgstr "Las existencias aún no se han cargado."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/stock/inventory_guard.xml:0
msgid "Products with insufficient stock:"
msgstr "Productos con existencias insuficientes:"

#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_block_add
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_block_add
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard

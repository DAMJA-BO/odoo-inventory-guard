msgstr "Impedir cantidades superiores a las existencias disponibles"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_show_order
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_show_order
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Show stock on order lines"
msgstr "Mostrar existencias en las líneas del pedido"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_available_filter
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_available_filter
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Enable Available only filter"
msgstr "Habilitar el filtro Solo disponibles"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_low_stock
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_low_stock
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Highlight low stock"
msgstr "Resaltar existencias bajas"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_low_threshold
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_low_threshold
msgid "Low stock threshold"
msgstr "Umbral de existencias bajas"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_auto_refresh
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_auto_refresh
#: model_terms:ir.ui.view,arch_db:pos_inventory_guard.res_config_settings_view_form_inventory_guard
msgid "Automatically refresh stock"
msgstr "Actualizar existencias automáticamente"

#. module: pos_inventory_guard
#: model:ir.model.fields,field_description:pos_inventory_guard.field_pos_config__inventory_guard_refresh_seconds
#: model:ir.model.fields,field_description:pos_inventory_guard.field_res_config_settings__pos_inventory_guard_refresh_seconds
msgid "Refresh interval (seconds)"
msgstr "Intervalo de actualización (segundos)"

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "Only Point of Sale users can check checkout stock."
msgstr "Solo los usuarios del Punto de venta pueden comprobar las existencias antes del cobro."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "The POS belongs to an unauthorized company."
msgstr "El PdV pertenece a una empresa no autorizada."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "Supply at most 200 numeric product IDs."
msgstr "Indique como máximo 200 identificadores numéricos de productos."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Configure an internal source location for the POS operation type."
msgstr "Configure una ubicación de origen interna para el tipo de operación del PdV."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "The POS source location must belong to the POS company."
msgstr "La ubicación de origen del PdV debe pertenecer a la empresa del PdV."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "Products must belong to the POS company or be shared."
msgstr "Los productos deben pertenecer a la empresa del PdV o ser compartidos."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "POS configuration not found."
msgstr "No se encontró la configuración del PdV."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "An open POS session is required."
msgstr "Se requiere una sesión de PdV abierta."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "The low stock threshold must be finite and nonnegative."
msgstr "El umbral de existencias bajas debe ser finito y no negativo."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_config.py:0
msgid "The stock refresh interval must be at least 5 seconds."
msgstr "El intervalo de actualización de existencias debe ser de al menos 5 segundos."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_order.py:0
msgid "Inventory Guard does not support ship-later orders."
msgstr "Inventory Guard no admite pedidos con envío posterior."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/pos_order.py:0
msgid "Inventory Guard could not complete the stock transfer. Check lots, serial numbers and stock configuration, then retry."
msgstr "Inventory Guard no pudo completar la transferencia de existencias. Compruebe los lotes, números de serie y la configuración de existencias, y vuelva a intentarlo."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Inventory Guard requires inventory updates after each POS order."
msgstr "Inventory Guard requiere actualizar el inventario después de cada pedido del PdV."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Insufficient stock at %(location)s:\n%(details)s"
msgstr "Existencias insuficientes en %(location)s:\n%(details)s"

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "One or more checkout products no longer exist."
msgstr "Uno o varios productos del pedido ya no existen."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Checkout quantities must be finite."
msgstr "Las cantidades del pedido deben ser finitas."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "A numeric product ID is required."
msgstr "Se requiere un identificador numérico de producto."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "%(product)s: requested %(requested)s; available %(available)s"
msgstr "%(product)s: solicitado %(requested)s; disponible %(available)s"

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Invalid checkout quantity."
msgstr "Cantidad del pedido no válida."

#. module: pos_inventory_guard
#. odoo-python
#: code:addons/pos_inventory_guard/models/inventory_guard.py:0
msgid "Checkout quantity is too large."
msgstr "La cantidad del pedido es demasiado grande."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/app/payment_screen_patch.js:0
#: code:addons/pos_inventory_guard/static/src/stock/store_patch.js:0
msgid "Stock verification unavailable"
msgstr "Verificación de existencias no disponible"

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/app/payment_screen_patch.js:0
msgid "Connect to the server before validating this sale."
msgstr "Conéctese al servidor antes de validar esta venta."

#. module: pos_inventory_guard
#. odoo-javascript
#: code:addons/pos_inventory_guard/static/src/app/payment_screen_patch.js:0
